# Novel Agent — Environment Variables
# Copy to .env and fill in your values.

# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
API_SERVER_URL=http://localhost:5005

# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
USE_NEO4J=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=novel_local_pw
USE_POSTGRES=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novel_processing
POSTGRES_USER=novel_user
POSTGRES_PASSWORD=novel_local_password
USE_QDRANT=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=novel_vectors
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=5005
LOG_LEVEL=INFO
